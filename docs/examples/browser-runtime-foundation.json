{
  "version": 1,
  "kind": "workspace_contract",
  "profile": "browser-input-javascript",
  "profiles": ["html5", "javascript", "browser-runtime"],
  "workspace": {
    "required_files": ["index.html", "app.js"]
  },
  "stages": [
    {
      "id": "html",
      "engine": "html.dom",
      "language": "html",
      "mode": "both",
      "targets": {
        "files": ["index.html"]
      },
      "rules": {
        "version": 2,
        "body": {
          "roots": [
            {
              "tag": { "value": "input", "errorMessage": "Need the name input" },
              "attributes": [
                { "name": "id", "value": "name", "errorMessage": "Use id name" }
              ]
            },
            {
              "tag": { "value": "p", "errorMessage": "Need a visible status" },
              "attributes": [
                { "name": "id", "value": "status", "errorMessage": "Use id status" }
              ]
            }
          ]
        }
      }
    },
    {
      "id": "javascript",
      "engine": "js.ast",
      "language": "js",
      "mode": "both",
      "depends_on": ["html"],
      "targets": {
        "files": ["app.js"],
        "entrypoint": "app.js"
      },
      "rules": {
        "maxFileSizeKb": 32
      }
    },
    {
      "id": "browser-runtime",
      "name": "Text input behavior",
      "engine": "browser.runtime",
      "language": "js",
      "mode": "final",
      "depends_on": ["html", "javascript"],
      "targets": {
        "files": ["index.html", "app.js"],
        "entrypoint": "index.html"
      },
      "checks": {
        "interactions": [
          {
            "selector": "#name",
            "action": "fill",
            "value": "Ada",
            "expectValue": { "value": "Ada" },
            "expectTextContains": {
              "selector": "#status",
              "value": "Hello, Ada"
            }
          },
          {
            "selector": "#name",
            "action": "fill",
            "value": "",
            "expectValue": { "value": "" },
            "expectTextContains": {
              "selector": "#status",
              "value": "Name is required"
            }
          }
        ]
      }
    }
  ],
  "links": []
}
